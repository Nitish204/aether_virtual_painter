# For local dev, SQLite is fine and needs no setup. In production, use
# a real Postgres URL (Render/Railway/Supabase all offer a free tier),
# since SQLite's file gets wiped on every redeploy on most hosts.
DATABASE_URL=sqlite+aiosqlite:///./aether.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/aether

# Generate a real one for production, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-in-production

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,https://your-aether-frontend.vercel.app

# Set to true in production (HTTPS) so session cookies require HTTPS.
COOKIE_SECURE=false

# Set to true only if deployed behind a proxy (Render/Railway) that you
# know overwrites X-Forwarded-For itself — see core/rate_limit.py.
TRUST_PROXY_HEADERS=false
